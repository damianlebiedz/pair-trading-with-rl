{
  "$defs": {
    "A2CAlgo": {
      "properties": {
        "algo_name": {
          "const": "a2c_baseline",
          "title": "Algo Name",
          "type": "string"
        },
        "policy_type": {
          "const": "MlpPolicy",
          "default": "MlpPolicy",
          "description": "Fixed policy type for A2C algorithm.",
          "title": "Policy Type",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/A2CBaseline"
        }
      },
      "required": [
        "algo_name",
        "params"
      ],
      "title": "A2CAlgo",
      "type": "object"
    },
    "A2CBaseline": {
      "properties": {
        "learning_rate": {
          "description": "Step size for the optimizer (learning rate for the A2C policy update).",
          "title": "Learning Rate",
          "type": "number"
        },
        "n_steps": {
          "description": "Number of forward steps to run for each environment before updating the network (typically small for A2C, e.g., 5).",
          "title": "N Steps",
          "type": "integer"
        },
        "gamma": {
          "description": "Discount factor for future rewards (between 0 and 1).",
          "title": "Gamma",
          "type": "number"
        },
        "ent_coef": {
          "description": "Entropy coefficient for the loss calculation. Higher values encourage more exploration.",
          "title": "Ent Coef",
          "type": "number"
        }
      },
      "required": [
        "learning_rate",
        "n_steps",
        "gamma",
        "ent_coef"
      ],
      "title": "A2CBaseline",
      "type": "object"
    },
    "BetaHedge": {
      "enum": [
        "no_hedge",
        "static",
        "rolling"
      ],
      "title": "BetaHedge",
      "type": "string"
    },
    "CointType": {
      "enum": [
        "eg",
        "johansen"
      ],
      "title": "CointType",
      "type": "string"
    },
    "Interval": {
      "enum": [
        "1d",
        "4h",
        "1h",
        "30m",
        "15m",
        "5m",
        "3m",
        "1m"
      ],
      "title": "Interval",
      "type": "string"
    },
    "Market": {
      "properties": {
        "initial_cash": {
          "description": "Starting capital for the backtest.",
          "exclusiveMinimum": 0,
          "title": "Initial Cash",
          "type": "number"
        },
        "fee_rate": {
          "description": "Transaction fee rate (e.g., 0.001 for 0.1%).",
          "minimum": 0,
          "title": "Fee Rate",
          "type": "number"
        },
        "risk_free_rate_annual": {
          "description": "Annual risk-free rate used for Sharpe/Sortino ratios.",
          "title": "Risk Free Rate Annual",
          "type": "number"
        },
        "interval": {
          "$ref": "#/$defs/Interval",
          "description": "Data timeframe used for the simulation. Options: ['1d', '4h', '1h', '30m', '15m', '5m', '3m', '1m']"
        }
      },
      "required": [
        "initial_cash",
        "fee_rate",
        "risk_free_rate_annual",
        "interval"
      ],
      "title": "Market",
      "type": "object"
    },
    "ObsSpaceType": {
      "enum": [
        "minimal",
        "standard",
        "full"
      ],
      "title": "ObsSpaceType",
      "type": "string"
    },
    "PPOAlgo": {
      "properties": {
        "algo_name": {
          "const": "recurrent_ppo",
          "title": "Algo Name",
          "type": "string"
        },
        "policy_type": {
          "const": "MlpLstmPolicy",
          "default": "MlpLstmPolicy",
          "description": "Fixed policy type for Recurrent PPO.",
          "title": "Policy Type",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RecurrentPPO"
        }
      },
      "required": [
        "algo_name",
        "params"
      ],
      "title": "PPOAlgo",
      "type": "object"
    },
    "PairSelection": {
      "properties": {
        "top_n_factor": {
          "description": "Factor determining how many top pairs to select.",
          "exclusiveMinimum": 0,
          "title": "Top N Factor",
          "type": "integer"
        },
        "coint_type": {
          "$ref": "#/$defs/CointType",
          "description": "Statistical test used for cointegration. Options: ['eg', 'johansen']"
        },
        "start": {
          "description": "Start date for pair selection.",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "End date for pair selection.",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "top_n_factor",
        "coint_type",
        "start",
        "end"
      ],
      "title": "PairSelection",
      "type": "object"
    },
    "Performance": {
      "properties": {
        "use_rl": {
          "description": "Use RL flag.",
          "title": "Use Rl",
          "type": "boolean"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the RL model file in data_rl/models.",
          "title": "Model Name"
        },
        "iterations": {
          "description": "Number of backtest iterations (monthly).",
          "exclusiveMinimum": 0,
          "title": "Iterations",
          "type": "integer"
        },
        "beta_hedge": {
          "$ref": "#/$defs/BetaHedge",
          "description": "Hedge ratio mode. Options: ['no_hedge', 'static', 'rolling']"
        },
        "delayed_entry": {
          "description": "Delayed entry flag.",
          "title": "Delayed Entry",
          "type": "boolean"
        },
        "sl_lock": {
          "description": "SL lock until mean-reversal flag.",
          "title": "Sl Lock",
          "type": "boolean"
        },
        "time_decay_sl": {
          "description": "Time Decay SL flag.",
          "title": "Time Decay Sl",
          "type": "boolean"
        },
        "test": {
          "$ref": "#/$defs/Test"
        }
      },
      "required": [
        "use_rl",
        "iterations",
        "beta_hedge",
        "delayed_entry",
        "sl_lock",
        "time_decay_sl",
        "test"
      ],
      "title": "Performance",
      "type": "object"
    },
    "RL": {
      "properties": {
        "training_subfolder": {
          "description": "Name of the folder with training data.",
          "title": "Training Subfolder",
          "type": "string"
        },
        "reward": {
          "$ref": "#/$defs/RLRewards",
          "description": "Type of RL reward. Options: ['pnl', 'pnl_signal']"
        },
        "obs_space_type": {
          "$ref": "#/$defs/ObsSpaceType",
          "description": "Type of observation space. Options: ['minimal', 'standard', 'full']"
        },
        "passes_per_pair": {
          "description": "Number of passes per pair during training.",
          "title": "Passes Per Pair",
          "type": "integer"
        },
        "seed": {
          "description": "Seed for random number generator.",
          "title": "Seed",
          "type": "integer"
        },
        "verbose": {
          "description": "Verbosity level in training.",
          "title": "Verbose",
          "type": "integer"
        }
      },
      "required": [
        "training_subfolder",
        "reward",
        "obs_space_type",
        "passes_per_pair",
        "seed",
        "verbose"
      ],
      "title": "RL",
      "type": "object"
    },
    "RLAlgoDefault": {
      "properties": {
        "rl_algo": {
          "$ref": "#/$defs/RLModelName"
        }
      },
      "required": [
        "rl_algo"
      ],
      "title": "RLAlgoDefault",
      "type": "object"
    },
    "RLModelName": {
      "enum": [
        "recurrent_ppo",
        "a2c_baseline"
      ],
      "title": "RLModelName",
      "type": "string"
    },
    "RLRewards": {
      "enum": [
        "pnl",
        "pnl_signal"
      ],
      "title": "RLRewards",
      "type": "string"
    },
    "RecurrentPPO": {
      "properties": {
        "learning_rate": {
          "description": "Step size for the optimizer (learning rate for the PPO policy update). Smaller values often yield more stable PPO training.",
          "title": "Learning Rate",
          "type": "number"
        },
        "n_steps": {
          "description": "Number of steps to run for each environment per update (PPO usually requires larger buffers than A2C, e.g., 128 or 256).",
          "title": "N Steps",
          "type": "integer"
        },
        "batch_size": {
          "description": "Minibatch size used for each gradient update during the optimization passes.",
          "title": "Batch Size",
          "type": "integer"
        },
        "n_epochs": {
          "description": "Number of optimization epochs (passes over the collected rollout data) when updating the network.",
          "title": "N Epochs",
          "type": "integer"
        },
        "gamma": {
          "description": "Discount factor for future rewards (between 0 and 1).",
          "title": "Gamma",
          "type": "number"
        },
        "ent_coef": {
          "description": "Entropy coefficient for the loss calculation. Higher values encourage more exploration.",
          "title": "Ent Coef",
          "type": "number"
        },
        "clip_range": {
          "description": "Range for clipping the surrogate objective. Prevents overly large policy updates to ensure stability (typically 0.2).",
          "title": "Clip Range",
          "type": "number"
        }
      },
      "required": [
        "learning_rate",
        "n_steps",
        "batch_size",
        "n_epochs",
        "gamma",
        "ent_coef",
        "clip_range"
      ],
      "title": "RecurrentPPO",
      "type": "object"
    },
    "RunBacktest": {
      "properties": {
        "test_start": {
          "description": "Start date for the backtest loop.",
          "title": "Test Start",
          "type": "string"
        },
        "test_end": {
          "description": "End date for the backtest loop.",
          "title": "Test End",
          "type": "string"
        },
        "performance": {
          "$ref": "#/$defs/Performance"
        }
      },
      "required": [
        "test_start",
        "test_end",
        "performance"
      ],
      "title": "RunBacktest",
      "type": "object"
    },
    "Settings": {
      "properties": {
        "vol_window": {
          "description": "Volatility window size (e.g. 24 = one day in '1h' interval).",
          "exclusiveMinimum": 0,
          "title": "Vol Window",
          "type": "integer"
        },
        "time_decay_min": {
          "description": "Start of Time Decay SL.",
          "minimum": 0,
          "title": "Time Decay Min",
          "type": "number"
        },
        "time_decay_max": {
          "description": "End of Time Decay SL.",
          "exclusiveMinimum": 0,
          "title": "Time Decay Max",
          "type": "number"
        }
      },
      "required": [
        "vol_window",
        "time_decay_min",
        "time_decay_max"
      ],
      "title": "Settings",
      "type": "object"
    },
    "Test": {
      "properties": {
        "beta_start": {
          "description": "Lookback window start date for beta calculation.",
          "title": "Beta Start",
          "type": "string"
        },
        "start": {
          "description": "Start date for test.",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "description": "End date for test.",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "beta_start",
        "start",
        "end"
      ],
      "title": "Test",
      "type": "object"
    },
    "Wandb": {
      "properties": {
        "project": {
          "description": "WandB project name.",
          "title": "Project",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/WandbMode",
          "description": "WandB tracking mode. Options: ['online', 'offline']"
        }
      },
      "required": [
        "project",
        "mode"
      ],
      "title": "Wandb",
      "type": "object"
    },
    "WandbMode": {
      "enum": [
        "online",
        "offline"
      ],
      "title": "WandbMode",
      "type": "string"
    }
  },
  "description": "Main validator.",
  "properties": {
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Name of the run/job for Hydra.",
      "title": "Name"
    },
    "defaults": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/RLAlgoDefault"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Hydra defaults list.",
      "title": "Defaults"
    },
    "tickers": {
      "description": "List of asset tickers.",
      "items": {
        "type": "string"
      },
      "title": "Tickers",
      "type": "array"
    },
    "generate_plots": {
      "description": "Generate plots if true.",
      "title": "Generate Plots",
      "type": "boolean"
    },
    "z_score_window": {
      "description": "Z-Score lookback window size.",
      "exclusiveMinimum": 0,
      "title": "Z Score Window",
      "type": "integer"
    },
    "entry_threshold": {
      "description": "Z-score threshold to open a position.",
      "title": "Entry Threshold",
      "type": "number"
    },
    "exit_threshold": {
      "description": "Z-score threshold to close a position.",
      "title": "Exit Threshold",
      "type": "number"
    },
    "stop_loss": {
      "description": "Stop loss multiplier (e.g., 1.05 for 5% from entry_threshold), None if trade without SL.",
      "exclusiveMinimum": 1,
      "title": "Stop Loss",
      "type": "number"
    },
    "market": {
      "$ref": "#/$defs/Market"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "pair_selection": {
      "$ref": "#/$defs/PairSelection"
    },
    "performance": {
      "$ref": "#/$defs/Performance"
    },
    "rl": {
      "anyOf": [
        {
          "$ref": "#/$defs/RL"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "RL config"
    },
    "run_backtest": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunBacktest"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "RunBacktest config"
    },
    "rl_algo": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "a2c_baseline": "#/$defs/A2CAlgo",
              "recurrent_ppo": "#/$defs/PPOAlgo"
            },
            "propertyName": "algo_name"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/A2CAlgo"
            },
            {
              "$ref": "#/$defs/PPOAlgo"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rl Algo"
    },
    "wandb": {
      "anyOf": [
        {
          "$ref": "#/$defs/Wandb"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "Config",
  "type": "object"
}